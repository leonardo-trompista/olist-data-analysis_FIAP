min_valor = top_states['total_orders'].min()
max_valor = top_states['total_orders'].max()


def obter_cor(valor):

    if max_valor == min_valor:
        posicao = 1

    else:
        posicao = (
            valor - min_valor
        ) / (
            max_valor - min_valor
        )

    indice = round(
        posicao * (len(paleta) - 1)
    )

    return paleta[indice]


