# ============================================================
# 1. COPIAR A SIMULAÇÃO EXISTENTE
# ============================================================

df_impacto_sla = df_sla.copy()


# ============================================================
# 2. CALCULAR PEDIDOS FORA DO SLA
# ============================================================

df_impacto_sla["pedidos_fora_sla"] = (
    total_pedidos
    - df_impacto_sla["pedidos_no_sla"]
)


# ============================================================
# 3. CALCULAR PERDA DE CUMPRIMENTO
#
# Quantos pontos percentuais são perdidos em relação
# ao cenário imediatamente anterior.
# ============================================================

df_impacto_sla["perda_percentual"] = (
    df_impacto_sla["percentual_no_sla"].shift(1)
    - df_impacto_sla["percentual_no_sla"]
)

df_impacto_sla["perda_percentual"] = (
    df_impacto_sla["perda_percentual"]
    .fillna(0)
)


# ============================================================
# 4. CALCULAR PEDIDOS ADICIONAIS FORA DO SLA
#
# Exemplo:
# SLA 0 → 7.828 fora
# SLA -1 → 9.286 fora
#
# Portanto:
# 9.286 - 7.828 = 1.458 pedidos adicionais
# ============================================================

df_impacto_sla["pedidos_adicionais_fora_sla"] = (
    df_impacto_sla["pedidos_fora_sla"]
    .diff()
    .fillna(0)
)


# ============================================================
# 5. VARIAÇÃO TOTAL EM RELAÇÃO AO SLA ATUAL
# ============================================================

sla_base = df_impacto_sla.iloc[0]

df_impacto_sla["perda_total_percentual"] = (
    sla_base["percentual_no_sla"]
    - df_impacto_sla["percentual_no_sla"]
)


df_impacto_sla["pedidos_adicionais_fora_total"] = (
    df_impacto_sla["pedidos_fora_sla"]
    - sla_base["pedidos_fora_sla"]
)


